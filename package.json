{
  "name": "l2d-viewer",
  "version": "2026.10.30",
  "type": "module",
  "description": "Live2D viewer web component",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StellaSoraWiki/l2d-viewer.git"
  },
  "main": "./dist/live2d-viewer.js",
  "module": "./dist/live2d-viewer.js",
  "types": "./dist/live2d-viewer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/live2d-viewer.d.ts",
      "import": "./dist/live2d-viewer.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "fetch:deps": "node scripts/fetch-deps.mjs",
    "fetch:deps:latest": "node scripts/fetch-deps.mjs --update-npm",
    "predev": "node scripts/fetch-deps.mjs",
    "prebuild": "node scripts/fetch-deps.mjs",
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:pages": "vite build --config vite.pages.config.ts",
    "test:unit": "vitest run tests/unit",
    "preview": "vite preview",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@lit/localize": "^0.12.2",
    "fflate": "^0.8.3",
    "lit": "^3.3.3",
    "modern-normalize": "^3.0.1",
    "pixi.js": "8.22.0",
    "untitled-pixi-live2d-engine": "1.4.0"
  },
  "devDependencies": {
    "@lit/localize-tools": "^0.8.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
